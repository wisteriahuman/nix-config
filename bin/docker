#!/usr/bin/env zsh

_real_docker() {
  local candidate
  for candidate in /opt/homebrew/bin/docker /usr/local/bin/docker /usr/bin/docker; do
    if [[ -x "$candidate" ]]; then
      "$candidate" "$@"
      return $?
    fi
  done
  print -u2 -- "docker: real binary not found"
  return 127
}

_docker_remote_target() {
  local ctx endpoint
  ctx=$(_real_docker context show 2>/dev/null)
  endpoint=$(_real_docker context inspect "$ctx" --format '{{.Endpoints.docker.Host}}' 2>/dev/null)
  [[ "$endpoint" == ssh://* ]] || return 1
  print -r -- "${endpoint#ssh://}"
}

if ! _DOCKER_REMOTE_HOST=$(_docker_remote_target); then
  _real_docker "$@"
  exit $?
fi

if ! command -v mutagen >/dev/null 2>&1; then
  print -u2 -- "docker: docker context is remote (${_DOCKER_REMOTE_HOST}) but mutagen is not installed; add it via nix-config"
  exit 127
fi

# ---- project identity: works for any directory, git or not ----
_project_slug() {
  local abs="${1:A}"
  local base="${abs:t}"
  local hash
  hash=$(print -r -- "$abs" | shasum -a 256 | cut -c1-10)
  print -r -- "${base}-${hash}"
}

_state_dir() {
  local slug=$1
  local d="$HOME/.cache/docker-remote-wrapper/$slug"
  mkdir -p "$d"
  print -r -- "$d"
}

_read_pid() {
  [[ -f "$1" ]] && cat "$1"
}

_pid_alive() {
  [[ -n "$1" ]] && kill -0 "$1" 2>/dev/null
}

# mkdir-based mutex: portable (no flock(1) on macOS). A crashed holder leaves the
# lock behind, so break it when the recorded pid is gone rather than time out.
_lock_acquire() {
  local lockdir=$1
  local tries=0
  while ! mkdir "$lockdir" 2>/dev/null; do
    local holder
    holder=$(cat "$lockdir/pid" 2>/dev/null)
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
      rm -rf "$lockdir" 2>/dev/null
      continue
    fi
    if (( tries++ >= 600 )); then
      print -u2 -- "docker: timed out waiting for sync lock $lockdir"
      return 1
    fi
    sleep 0.1
  done
  print -r -- $$ > "$lockdir/pid"
  return 0
}

_lock_release() {
  rm -rf "$1" 2>/dev/null
}

# background jobs don't get their own process group (no job control in a script),
# so `kill -- -$pid` doesn't reach children - kill direct children then the pid.
_kill_pid() {
  [[ -z "$1" ]] && return
  pkill -P "$1" 2>/dev/null
  kill "$1" 2>/dev/null
  wait "$1" 2>/dev/null
}

# ---- mutagen-backed file sync ----
# One session per project directory, named from its slug. Bidirectional so
# container-generated artifacts flow back; conflicts resolve in favour of the
# Mac copy. The daemon is started on demand and stopped once no session is left.

_mutagen_name() {
  local s="${1//[^a-zA-Z0-9_-]/-}"
  print -r -- "dr-${s[1,58]}"
}

_remote_sync_path() {
  local local_path=$1
  local rel_path="${local_path#/}"
  ssh "$_DOCKER_REMOTE_HOST" \
    "d=\"\$HOME/.cache/docker-remote-sync/$rel_path\"; mkdir -p \"\$d\" && print -r -- \"\$d\"" 2>/dev/null
}

typeset -ga _MUTAGEN_IGNORE

# .dockerremoteignore entries are passed through as mutagen ignore patterns
# (gitignore-like syntax, not rsync's).
_mutagen_build_ignore() {
  local local_path=$1
  _MUTAGEN_IGNORE=(--ignore-vcs --ignore '.env' --ignore '.env.*')
  local ignorefile="$local_path/.dockerremoteignore"
  [[ -f "$ignorefile" ]] || return 0
  local line
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == '#'* ]] && continue
    _MUTAGEN_IGNORE+=(--ignore "$line")
  done < "$ignorefile"
}

_mutagen_session_exists() {
  command mutagen sync list --template '{{range .}}{{.Name}}{{"\n"}}{{end}}' 2>/dev/null \
    | grep -qx "$1"
}

_mutagen_flush() {
  command mutagen sync flush "$1" >/dev/null 2>&1 \
    || print -u2 -- "docker: warning: mutagen sync '$1' did not flush cleanly (run: mutagen sync list)"
}

_mutagen_ensure() {
  local name=$1 alpha=$2 beta=$3 ignore_root=$4
  _mutagen_session_exists "$name" && return 0
  _mutagen_build_ignore "$ignore_root"
  command mutagen sync create \
    --name="$name" \
    --sync-mode=two-way-resolved \
    --symlink-mode=posix-raw \
    "${_MUTAGEN_IGNORE[@]}" \
    "$alpha" "$beta" >/dev/null || return 1
  _mutagen_flush "$name"
}

_mutagen_session_count() {
  command mutagen sync list --template '{{len .}}' 2>/dev/null || print -r -- 0
}

_mutagen_stop_daemon_if_idle() {
  [[ "$(_mutagen_session_count)" == 0 ]] || return 0
  command mutagen daemon stop >/dev/null 2>&1
}

# Idempotent: sync session + tunnel are (re)established only if missing.
# Safe to call repeatedly / concurrently for the same project (lock-guarded).
# Does NOT touch tmux - only `up` cares about the tmux session.
_ensure_session() {
  local local_dir=$1 slug=$2 state=$3
  shift 3
  local -a compose_files=("$@")
  local lockdir="$state/.lock"

  if ! _lock_acquire "$lockdir"; then
    return 1
  fi

  local remote_dir
  remote_dir=$(_remote_sync_path "$local_dir")
  if [[ -z "$remote_dir" ]]; then
    _lock_release "$lockdir"
    return 1
  fi

  if ! _mutagen_ensure "$(_mutagen_name "$slug")" "$local_dir" "${_DOCKER_REMOTE_HOST}:${remote_dir}" "$local_dir"; then
    _lock_release "$lockdir"
    return 1
  fi

  local tpid=$(_read_pid "$state/tunnel.pid")
  if ! _pid_alive "$tpid"; then
    local ports
    ports=$(ssh "$_DOCKER_REMOTE_HOST" "cd '$remote_dir' && docker compose ${compose_files[@]} config --format json" 2>/dev/null \
      | jq -r '[.services[].ports[]?.published] | unique | .[]' 2>/dev/null)
    if [[ -n "$ports" ]]; then
      local -a port_args
      local p
      for p in ${(f)ports}; do
        port_args+=(-L "${p}:localhost:${p}")
      done
      ssh -N "${port_args[@]}" "$_DOCKER_REMOTE_HOST" &
      tpid=$!
      print -r -- "$tpid" > "$state/tunnel.pid"
    fi
  fi

  _lock_release "$lockdir"
  print -r -- "$remote_dir"
}

_teardown_session() {
  local state=$1 session=$2 slug=$3
  ssh "$_DOCKER_REMOTE_HOST" "tmux kill-session -t '$session' 2>/dev/null"
  _kill_pid "$(_read_pid "$state/tunnel.pid")"
  command mutagen sync terminate "$(_mutagen_name "$slug")" >/dev/null 2>&1
  _mutagen_stop_daemon_if_idle
  rm -rf "$state"
}

# `up`: runs inside a remote tmux session so the container lifecycle is tied
# to that session (survives ssh disconnects), not to this invocation.
# -d only controls whether *this local wrapper call* attaches or returns.
_compose_up() {
  local remote_dir=$1 session=$2 slug=$3
  shift 3
  local -a up_args=("$@")
  local detach=0 a
  local -a fg_args
  for a in "${up_args[@]}"; do
    if [[ "$a" == "-d" || "$a" == "--detach" ]]; then
      detach=1
    else
      fg_args+=("$a")
    fi
  done

  _mutagen_flush "$(_mutagen_name "$slug")"

  local exists
  exists=$(ssh "$_DOCKER_REMOTE_HOST" "tmux has-session -t '$session' 2>/dev/null && print -r -- yes")
  if [[ "$exists" != "yes" ]]; then
    local up_cmd="docker compose up ${(@q)fg_args}"
    print -u2 -- "docker: starting 'docker compose up' in tmux session '$session' on ${_DOCKER_REMOTE_HOST}"
    ssh "$_DOCKER_REMOTE_HOST" "tmux new-session -d -s '$session' -c '$remote_dir' '$up_cmd'"
  else
    print -u2 -- "docker: '$session' already running on ${_DOCKER_REMOTE_HOST}, reusing it"
  fi

  if (( detach )); then
    print -u2 -- "docker: containers starting in background on ${_DOCKER_REMOTE_HOST}."
    print -u2 -- "docker: reattach with 'docker compose up' (no -d), or: ssh ${_DOCKER_REMOTE_HOST} tmux attach -t $session"
    return 0
  fi

  print -u2 -- "docker: attaching (Ctrl-b d to detach and keep running, Ctrl-C to stop compose)"
  ssh -t "$_DOCKER_REMOTE_HOST" "tmux attach -t '$session'"
  return $?
}

# `down`: stop compose, flush a final sync so artifacts land locally, then tear
# down the tmux session, the tunnel and (if idle) the mutagen daemon.
_compose_down() {
  local local_dir=$1 remote_dir=$2 session=$3 state=$4 slug=$5
  shift 5
  print -u2 -- "docker: stopping containers on ${_DOCKER_REMOTE_HOST}"
  ssh -t "$_DOCKER_REMOTE_HOST" "cd '$remote_dir' && docker compose down $*"
  local rc=$?
  _mutagen_flush "$(_mutagen_name "$slug")"
  _teardown_session "$state" "$session" "$slug"
  return $rc
}

_docker_remote_compose() {
  local local_dir=$PWD
  local slug=$(_project_slug "$local_dir")
  local state=$(_state_dir "$slug")
  local session="dr-${slug}"
  local sub=$1

  local -a compose_files
  local i=1
  while (( i <= $# )); do
    case "${@[i]}" in
      -f|--file)
        (( i++ ))
        compose_files+=(-f "${@[i]}")
        ;;
    esac
    (( i++ ))
  done

  local remote_dir
  if [[ "$sub" == "down" ]]; then
    remote_dir=$(_remote_sync_path "$local_dir")
  else
    remote_dir=$(_ensure_session "$local_dir" "$slug" "$state" "${compose_files[@]}")
  fi
  if [[ -z "$remote_dir" ]]; then
    print -u2 -- "docker: failed to sync $local_dir to ${_DOCKER_REMOTE_HOST}"
    return 1
  fi

  shift
  case "$sub" in
    up)
      _compose_up "$remote_dir" "$session" "$slug" "$@"
      ;;
    down)
      _compose_down "$local_dir" "$remote_dir" "$session" "$state" "$slug" "$@"
      ;;
    *)
      _mutagen_flush "$(_mutagen_name "$slug")"
      print -u2 -- "docker: running on ${_DOCKER_REMOTE_HOST}"
      ssh -t "$_DOCKER_REMOTE_HOST" "cd '$remote_dir' && docker compose $sub $*"
      local rc=$?
      _mutagen_flush "$(_mutagen_name "$slug")"
      return $rc
      ;;
  esac
}

_docker_remote_run() {
  local -a args=("$@")
  local -a mnames
  local -a port_args
  local i=1

  while (( i <= $#args )); do
    case "${args[i]}" in
      -v|--volume)
        (( i++ ))
        local spec="${args[i]}"
        local src="${spec%%:*}"
        if [[ "$src" == /* || "$src" == .* || "$src" == "~"* ]]; then
          local abs_src="${src:A}"
          local rp
          rp=$(_remote_sync_path "$abs_src")
          if [[ -n "$rp" ]]; then
            local mn=$(_mutagen_name "run-$(_project_slug "$abs_src")")
            if _mutagen_ensure "$mn" "$abs_src" "${_DOCKER_REMOTE_HOST}:${rp}" "$abs_src"; then
              args[i]="${rp}${spec#$src}"
              mnames+=("$mn")
            fi
          fi
        fi
        ;;
      --mount)
        (( i++ ))
        if [[ "${args[i]}" == *type=bind* ]]; then
          local src
          src=$(print -r -- "${args[i]}" | sed -n 's/.*source=\([^,]*\).*/\1/p')
          if [[ -n "$src" ]]; then
            local abs_src="${src:A}"
            local rp
            rp=$(_remote_sync_path "$abs_src")
            if [[ -n "$rp" ]]; then
              local mn=$(_mutagen_name "run-$(_project_slug "$abs_src")")
              if _mutagen_ensure "$mn" "$abs_src" "${_DOCKER_REMOTE_HOST}:${rp}" "$abs_src"; then
                args[i]="${args[i]/source=$src/source=$rp}"
                mnames+=("$mn")
              fi
            fi
          fi
        fi
        ;;
      -p|--publish)
        (( i++ ))
        local port="${args[i]%%:*}"
        port_args+=(-L "${port}:localhost:${port}")
        ;;
    esac
    (( i++ ))
  done

  local _run_cleanup_done=0
  _run_cleanup() {
    (( _run_cleanup_done )) && return
    _run_cleanup_done=1
    local mn
    for mn in "${mnames[@]}"; do
      _mutagen_flush "$mn"
      command mutagen sync terminate "$mn" >/dev/null 2>&1
    done
    _mutagen_stop_daemon_if_idle
  }
  (( ${#mnames} > 0 )) && trap '_run_cleanup' EXIT INT TERM

  print -u2 -- "docker: running on ${_DOCKER_REMOTE_HOST}"
  ssh -t "${port_args[@]}" "$_DOCKER_REMOTE_HOST" "docker run ${args[*]}"
  local exit_code=$?

  _run_cleanup
  trap - EXIT INT TERM
  return $exit_code
}

case "$1" in
  compose)
    _docker_remote_compose "${@:2}"
    exit $?
    ;;
  run|create)
    _docker_remote_run "${@:2}"
    exit $?
    ;;
  *)
    _real_docker "$@"
    exit $?
    ;;
esac
