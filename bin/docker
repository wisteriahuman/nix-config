#!/usr/bin/env zsh

_real_docker() {
  local candidate
  for candidate in /opt/homebrew/bin/docker /usr/local/bin/docker /usr/bin/docker; do
    if [[ -x "$candidate" ]]; then
      "$candidate" "$@"
      return $?
    fi
  done
  print -u2 -- "docker: real binary not found"
  return 127
}

_docker_remote_target() {
  local ctx endpoint
  ctx=$(_real_docker context show 2>/dev/null)
  endpoint=$(_real_docker context inspect "$ctx" --format '{{.Endpoints.docker.Host}}' 2>/dev/null)
  [[ "$endpoint" == ssh://* ]] || return 1
  print -r -- "${endpoint#ssh://}"
}

if ! _DOCKER_REMOTE_HOST=$(_docker_remote_target); then
  _real_docker "$@"
  exit $?
fi

if ! command -v mutagen >/dev/null 2>&1; then
  print -u2 -- "docker: docker context is remote (${_DOCKER_REMOTE_HOST}) but mutagen is not installed; add it via nix-config"
  exit 127
fi

# ---- compose file detection: don't sync/tunnel for directories that aren't
# actually a compose project (e.g. a subdirectory of one). Mirrors how plain
# `docker compose` only looks at $PWD, not parent directories. ----
_has_compose_project() {
  local -a args=("$@")
  local i=1
  while (( i <= $#args )); do
    case "${args[i]}" in
      -f|--file|--file=*) return 0 ;;
    esac
    (( i++ ))
  done
  local f
  for f in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do
    [[ -f "$f" ]] && return 0
  done
  [[ -n "$COMPOSE_FILE" ]] && return 0
  return 1
}

# ---- project identity: works for any directory, git or not ----
_project_slug() {
  local abs="${1:A}"
  local base="${abs:t}"
  local hash
  hash=$(print -r -- "$abs" | shasum -a 256 | cut -c1-10)
  print -r -- "${base}-${hash}"
}

_state_dir() {
  local slug=$1
  local d="$HOME/.cache/docker-remote-wrapper/$slug"
  mkdir -p "$d"
  print -r -- "$d"
}

_read_file() {
  [[ -f "$1" ]] && cat "$1"
}

_pid_alive() {
  [[ -n "$1" ]] && kill -0 "$1" 2>/dev/null
}

# mkdir-based mutex: portable (no flock(1) on macOS). A crashed holder leaves the
# lock behind, so break it when the recorded pid is gone rather than time out.
_lock_acquire() {
  local lockdir=$1
  local tries=0
  while ! mkdir "$lockdir" 2>/dev/null; do
    local holder
    holder=$(cat "$lockdir/pid" 2>/dev/null)
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
      rm -rf "$lockdir" 2>/dev/null
      continue
    fi
    if (( tries++ >= 600 )); then
      print -u2 -- "docker: timed out waiting for sync lock $lockdir"
      return 1
    fi
    sleep 0.1
  done
  print -r -- $$ > "$lockdir/pid"
  return 0
}

_lock_release() {
  rm -rf "$1" 2>/dev/null
}

# background jobs don't get their own process group (no job control in a script),
# so `kill -- -$pid` doesn't reach children - kill direct children then the pid.
_kill_pid() {
  [[ -z "$1" ]] && return
  pkill -P "$1" 2>/dev/null
  kill "$1" 2>/dev/null
  wait "$1" 2>/dev/null
}

# ---- mutagen-backed file sync ----
# One session per project directory, named from its slug. Bidirectional so
# container-generated artifacts flow back; conflicts resolve in favour of the
# Mac copy. The daemon is started on demand and stopped once no session is left.

_mutagen_name() {
  local s="${1//[^a-zA-Z0-9_-]/-}"
  print -r -- "dr-${s[1,58]}"
}

_remote_sync_path() {
  local local_path=$1
  local rel_path="${local_path#/}"
  ssh "$_DOCKER_REMOTE_HOST" \
    "d=\"\$HOME/.cache/docker-remote-sync/$rel_path\"; mkdir -p \"\$d\" && print -r -- \"\$d\"" 2>/dev/null
}

typeset -ga _MUTAGEN_IGNORE

# .dockerremoteignore entries are passed through as mutagen ignore patterns
# (gitignore-like syntax, not rsync's). .git and env files are project files
# too: sync them by default so remote bind mounts behave like local bind
# mounts (a container running `git`/`lefthook` needs .git to be there).
_mutagen_build_ignore() {
  local local_path=$1
  _MUTAGEN_IGNORE=()
  local ignorefile="$local_path/.dockerremoteignore"
  [[ -f "$ignorefile" ]] || return 0
  local line
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == '#'* ]] && continue
    _MUTAGEN_IGNORE+=(--ignore "$line")
  done < "$ignorefile"
}

_mutagen_session_exists() {
  command mutagen sync list --template '{{range .}}{{.Name}}{{"\n"}}{{end}}' 2>/dev/null \
    | grep -qx "$1"
}

_mutagen_flush() {
  command mutagen sync flush "$1" >/dev/null 2>&1 \
    || print -u2 -- "docker: warning: mutagen sync '$1' did not flush cleanly (run: mutagen sync list)"
}

_mutagen_ensure() {
  local name=$1 alpha=$2 beta=$3 ignore_root=$4
  _mutagen_session_exists "$name" && return 0
  _mutagen_build_ignore "$ignore_root"
  command mutagen sync create \
    --name="$name" \
    --sync-mode=two-way-resolved \
    --symlink-mode=posix-raw \
    --default-directory-mode=0755 \
    --default-file-mode=0644 \
    "${_MUTAGEN_IGNORE[@]}" \
    "$alpha" "$beta" >/dev/null || return 1
  _mutagen_flush "$name"
}

_mutagen_session_count() {
  command mutagen sync list --template '{{len .}}' 2>/dev/null || print -r -- 0
}

_mutagen_stop_daemon_if_idle() {
  [[ "$(_mutagen_session_count)" == 0 ]] || return 0
  command mutagen daemon stop >/dev/null 2>&1
}

# Reclaim state dirs left behind by a project whose tunnel died and whose
# mutagen session is gone too (host reboot, manual cleanup, killed tunnel).
# Skips anything mid-operation (holding the lock) or still alive.
_gc_stale_state_dirs() {
  local base="$HOME/.cache/docker-remote-wrapper"
  [[ -d "$base" ]] || return 0
  local active_sessions
  active_sessions=$(command mutagen sync list --template '{{range .}}{{.Name}}{{"\n"}}{{end}}' 2>/dev/null)
  local d slug
  for d in "$base"/*/; do
    [[ -d "$d" ]] || continue
    [[ -d "${d}.lock" ]] && continue
    _pid_alive "$(_read_file "${d}tunnel.pid")" && continue
    slug="${${d%/}:t}"
    print -r -- "$active_sessions" | grep -qx "$(_mutagen_name "$slug")" && continue
    rm -rf "$d"
  done
}

# Idempotent: sync session + tunnel are (re)established only if missing.
# Safe to call repeatedly / concurrently for the same project (lock-guarded).
# Does NOT touch tmux - only `up` cares about the tmux session.
_ensure_session() {
  local local_dir=$1 slug=$2 state=$3
  shift 3
  local -a compose_files=("$@")
  local lockdir="$state/.lock"

  if ! _lock_acquire "$lockdir"; then
    return 1
  fi

  local remote_dir
  remote_dir=$(_remote_sync_path "$local_dir")
  if [[ -z "$remote_dir" ]]; then
    _lock_release "$lockdir"
    return 1
  fi

  if ! _mutagen_ensure "$(_mutagen_name "$slug")" "$local_dir" "${_DOCKER_REMOTE_HOST}:${remote_dir}" "$local_dir"; then
    _lock_release "$lockdir"
    return 1
  fi

  local tpid=$(_read_file "$state/tunnel.pid")
  local ports
  ports=$(ssh "$_DOCKER_REMOTE_HOST" "cd '$remote_dir' && docker compose ${compose_files[@]} config --format json" 2>/dev/null \
    | jq -r '[.services[].ports[]?.published] | unique | .[]' 2>/dev/null)
  local ports_key="${(j:,:)${(f)ports}}"
  local prev_ports_key=$(_read_file "$state/tunnel.ports")

  # compose.yml grew/shrank its port list since the tunnel was opened: the
  # running tunnel only forwards the old set, so replace it.
  if _pid_alive "$tpid" && [[ "$ports_key" != "$prev_ports_key" ]]; then
    _kill_pid "$tpid"
    tpid=""
  fi

  if [[ -n "$ports" ]] && ! _pid_alive "$tpid"; then
    local -a port_args
    local p
    for p in ${(f)ports}; do
      port_args+=(-L "${p}:localhost:${p}")
    done
    ssh -N "${port_args[@]}" "$_DOCKER_REMOTE_HOST" &
    tpid=$!
    print -r -- "$tpid" > "$state/tunnel.pid"
    print -r -- "$ports_key" > "$state/tunnel.ports"
  fi

  _lock_release "$lockdir"
  print -r -- "$remote_dir"
}

_teardown_session() {
  local state=$1 session=$2 slug=$3
  # best-effort: don't let a stuck lock holder block teardown forever, but
  # avoid racing a concurrent `up` for the same project when we can.
  _lock_acquire "$state/.lock"
  ssh "$_DOCKER_REMOTE_HOST" "tmux kill-session -t '$session' 2>/dev/null"
  _kill_pid "$(_read_file "$state/tunnel.pid")"
  command mutagen sync terminate "$(_mutagen_name "$slug")" >/dev/null 2>&1
  _mutagen_stop_daemon_if_idle
  rm -rf "$state"
}

# Detached `up` runs synchronously over SSH: Compose starts the containers in
# the background, and its output and exit code reach the caller. Foreground
# `up` retains the tmux session for reconnecting after an SSH disconnect.
_compose_up() {
  local remote_dir=$1 session=$2 slug=$3
  shift 3
  local -a up_args=("$@")
  local detach=0 wait_for_services=0 a
  for a in "${up_args[@]}"; do
    case "$a" in
      -d|--detach|-d=true|--detach=true) detach=1 ;;
      -d=false|--detach=false) detach=0 ;;
      --wait|--wait=true) wait_for_services=1 ;;
      --wait=false) wait_for_services=0 ;;
      --) break ;;
    esac
  done

  _mutagen_flush "$(_mutagen_name "$slug")"

  if (( detach || wait_for_services )); then
    # Quote each argument for the remote shell, including paths with spaces.
    local -a compose_cmd=(docker compose up "${up_args[@]}")
    local -a quoted_cmd=("${(@qq)compose_cmd}")
    local remote_cmd="cd ${(qq)remote_dir} && ${(j: :)quoted_cmd}"
    print -u2 -- "docker: running on ${_DOCKER_REMOTE_HOST}"
    ssh -T "$_DOCKER_REMOTE_HOST" "$remote_cmd"
    local rc=$?
    _mutagen_flush "$(_mutagen_name "$slug")"
    return $rc
  fi

  # Flags that change how containers get (re)built: reusing the existing
  # tmux session would silently drop them, so restart it instead.
  local -a recreate_flags=(--build --force-recreate --renew-anon-volumes --pull --always-recreate-deps -V --remove-orphans)
  local wants_recreate=0 r
  for a in "${up_args[@]}"; do
    for r in "${recreate_flags[@]}"; do
      [[ "$a" == "$r" || "$a" == ${r}=* ]] && wants_recreate=1
    done
  done

  local exists
  exists=$(ssh "$_DOCKER_REMOTE_HOST" "tmux has-session -t '$session' 2>/dev/null && print -r -- yes")
  if [[ "$exists" == "yes" && $wants_recreate -eq 1 ]]; then
    print -u2 -- "docker: '$session' is running but these flags need a restart; stopping it first"
    ssh "$_DOCKER_REMOTE_HOST" "tmux send-keys -t '$session' C-c" 2>/dev/null
    sleep 1
    ssh "$_DOCKER_REMOTE_HOST" "tmux kill-session -t '$session' 2>/dev/null"
    exists=no
  fi
  if [[ "$exists" != "yes" ]]; then
    local up_cmd="docker compose up ${(@q)up_args}"
    print -u2 -- "docker: starting 'docker compose up' in tmux session '$session' on ${_DOCKER_REMOTE_HOST}"
    ssh "$_DOCKER_REMOTE_HOST" "tmux new-session -d -s '$session' -c '$remote_dir' '$up_cmd'" || return $?
  else
    print -u2 -- "docker: '$session' already running on ${_DOCKER_REMOTE_HOST}, reusing it"
  fi

  print -u2 -- "docker: attaching (Ctrl-b d to detach and keep running, Ctrl-C to stop compose)"
  ssh -t "$_DOCKER_REMOTE_HOST" "tmux attach -t '$session'"
  return $?
}

# `down`: stop compose, flush a final sync so artifacts land locally, then tear
# down the tmux session, the tunnel and (if idle) the mutagen daemon.
_compose_down() {
  local local_dir=$1 remote_dir=$2 session=$3 state=$4 slug=$5
  shift 5
  print -u2 -- "docker: stopping containers on ${_DOCKER_REMOTE_HOST}"
  ssh -t "$_DOCKER_REMOTE_HOST" "cd '$remote_dir' && docker compose down $*"
  local rc=$?
  _mutagen_flush "$(_mutagen_name "$slug")"
  _teardown_session "$state" "$session" "$slug"
  return $rc
}

_docker_remote_compose() {
  local local_dir=$PWD
  local slug=$(_project_slug "$local_dir")
  local state=$(_state_dir "$slug")
  local session="dr-${slug}"
  local sub=$1

  local -a compose_files
  local i=1
  while (( i <= $# )); do
    case "${@[i]}" in
      -f|--file)
        (( i++ ))
        compose_files+=(-f "${@[i]}")
        ;;
      --file=*)
        compose_files+=(-f "${${@[i]}#--file=}")
        ;;
    esac
    (( i++ ))
  done

  # Every subcommand (including `down`) needs the project actually synced
  # first - `down` as the very first command run against a project used to
  # skip this and fail against an empty remote directory.
  local remote_dir
  remote_dir=$(_ensure_session "$local_dir" "$slug" "$state" "${compose_files[@]}")
  if [[ -z "$remote_dir" ]]; then
    print -u2 -- "docker: failed to sync $local_dir to ${_DOCKER_REMOTE_HOST}"
    return 1
  fi

  shift
  case "$sub" in
    up)
      _compose_up "$remote_dir" "$session" "$slug" "$@"
      ;;
    down)
      _compose_down "$local_dir" "$remote_dir" "$session" "$state" "$slug" "$@"
      ;;
    *)
      _mutagen_flush "$(_mutagen_name "$slug")"
      print -u2 -- "docker: running on ${_DOCKER_REMOTE_HOST}"
      ssh -t "$_DOCKER_REMOTE_HOST" "cd '$remote_dir' && docker compose $sub $*"
      local rc=$?
      _mutagen_flush "$(_mutagen_name "$slug")"
      return $rc
      ;;
  esac
}

_docker_remote_run() {
  local -a args=("$@")
  local -a mnames
  local -a port_args
  local i=1

  while (( i <= $#args )); do
    case "${args[i]}" in
      -v|--volume)
        (( i++ ))
        local spec="${args[i]}"
        local src="${spec%%:*}"
        if [[ "$src" == /* || "$src" == .* || "$src" == "~"* ]]; then
          local abs_src="${src:A}"
          local rp
          rp=$(_remote_sync_path "$abs_src")
          if [[ -n "$rp" ]]; then
            local mn=$(_mutagen_name "run-$(_project_slug "$abs_src")")
            if _mutagen_ensure "$mn" "$abs_src" "${_DOCKER_REMOTE_HOST}:${rp}" "$abs_src"; then
              args[i]="${rp}${spec#$src}"
              mnames+=("$mn")
            fi
          fi
        fi
        ;;
      --mount)
        (( i++ ))
        if [[ "${args[i]}" == *type=bind* ]]; then
          local src
          src=$(print -r -- "${args[i]}" | sed -n 's/.*source=\([^,]*\).*/\1/p')
          if [[ -n "$src" ]]; then
            local abs_src="${src:A}"
            local rp
            rp=$(_remote_sync_path "$abs_src")
            if [[ -n "$rp" ]]; then
              local mn=$(_mutagen_name "run-$(_project_slug "$abs_src")")
              if _mutagen_ensure "$mn" "$abs_src" "${_DOCKER_REMOTE_HOST}:${rp}" "$abs_src"; then
                args[i]="${args[i]/source=$src/source=$rp}"
                mnames+=("$mn")
              fi
            fi
          fi
        fi
        ;;
      -p|--publish)
        (( i++ ))
        # HOSTPORT:CONTAINERPORT, IP:HOSTPORT:CONTAINERPORT, or bare
        # CONTAINERPORT (docker picks a random host port for that last one -
        # nothing we can tunnel to, so skip it instead of forwarding the
        # wrong field).
        local -a parts=("${(@s.:.)args[i]}")
        local host_port=""
        case ${#parts} in
          2) host_port="${parts[1]}" ;;
          3) host_port="${parts[2]}" ;;
        esac
        if [[ -n "$host_port" ]]; then
          port_args+=(-L "${host_port}:localhost:${host_port}")
        else
          print -u2 -- "docker: warning: -p ${args[i]} has no fixed host port; not tunneling it"
        fi
        ;;
    esac
    (( i++ ))
  done

  local _run_cleanup_done=0
  _run_cleanup() {
    (( _run_cleanup_done )) && return
    _run_cleanup_done=1
    local mn
    for mn in "${mnames[@]}"; do
      _mutagen_flush "$mn"
      command mutagen sync terminate "$mn" >/dev/null 2>&1
    done
    _mutagen_stop_daemon_if_idle
  }
  (( ${#mnames} > 0 )) && trap '_run_cleanup' EXIT INT TERM

  print -u2 -- "docker: running on ${_DOCKER_REMOTE_HOST}"
  ssh -t "${port_args[@]}" "$_DOCKER_REMOTE_HOST" "docker run ${args[*]}"
  local exit_code=$?

  _run_cleanup
  trap - EXIT INT TERM
  return $exit_code
}

_gc_stale_state_dirs

case "$1" in
  compose)
    if _has_compose_project "${@:2}"; then
      _docker_remote_compose "${@:2}"
      exit $?
    fi
    _real_docker "$@"
    exit $?
    ;;
  run|create)
    _docker_remote_run "${@:2}"
    exit $?
    ;;
  *)
    _real_docker "$@"
    exit $?
    ;;
esac
